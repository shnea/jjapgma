{
  "name": "jjapgma",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "lint": "oxlint apps packages tests",
    "typecheck": "tsc -p packages/ui-spec && tsc -p apps/api --noEmit && tsc -p apps/web --noEmit",
    "build": "tsc -p packages/ui-spec && tsc -p apps/api && vite build --config apps/web/vite.config.ts",
    "test": "tsx --test packages/ui-spec/src/*.test.ts",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "storybook": "storybook dev -p 6006 --config-dir apps/web/.storybook",
    "build-storybook": "storybook build --config-dir apps/web/.storybook --output-dir apps/web/storybook-static",
    "test:stories": "playwright test --config tests/storybook.config.ts",
    "migrate": "node apps/api/dist/database/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "jose": "6.2.12",
    "lucide-react": "1.46.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "http-server": "14.1.1",
    "oxlint": "1.83.0",
    "prettier": "3.9.6",
    "storybook": "10.6.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
