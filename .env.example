# 앱
APP_URL=https://jjapgma.shnea.kr
DEV_AUTH_BYPASS=false


# 배포 이미지 (운영)
REGISTRY=registry.shnea.kr
IMAGE_TAG=


# 웹 프록시
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=30137


# 데이터베이스 (운영): 연결 주소의 비밀번호는 URL 인코딩
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=30138
DB_PASSWORD=
DATABASE_URL=postgres://jjapgma:URL_ENCODED_PASSWORD@db:5432/jjapgma


# 로그인: 암호화 키는 64자리 16진수
OIDC_CLIENT_ID=jjapgma
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile basic offline_access
REFRESH_TOKEN_ENCRYPTION_KEY=


# 파일 서비스
FILE_SERVICE_BASE_URL=https://file.shnea.kr
FILE_SERVICE_BEARER_TOKEN=
UPLOAD_MAX_BYTES=10485760


# 공유: auto=즉시 승인, email=메일 수락 / 유효시간은 초
SHARE_APPROVAL_MODE=auto
VERIFY_EMAIL_TTL_SECONDS=86400


# 알림 서비스: notify:send 권한 필요
NOTIFY_API_URL=
NOTIFY_API_TOKEN=


# AI: n8n 인증·MCP 설정 후 활성화, 토큰은 서버 전용 32자 이상
AI_ENABLED=false
AI_WEBHOOK_URL=https://n8n.shnea.kr/webhook/jjapgma
AI_WEBHOOK_TOKEN=
AI_MCP_TOKEN=
