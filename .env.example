# Production only. Compose interpolates these values; no secrets enter web builds.
REGISTRY=registry.shnea.kr
# Immutable release tag (commit SHA), never latest.
IMAGE_TAG=
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=30137
# Keep loopback until the permitted administrative network is agreed.
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=30138
# Required. Use a strong password; percent-encode it in DATABASE_URL.
DB_PASSWORD=
DATABASE_URL=postgres://jjapgma:URL_ENCODED_PASSWORD@db:5432/jjapgma
OIDC_CLIENT_ID=jjapgma-web
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile basic offline_access
# Required: 32 cryptographically random bytes encoded as 64 hex characters.
REFRESH_TOKEN_ENCRYPTION_KEY=
# File uploads. Server only; leave token blank to disable uploads explicitly.
FILE_SERVICE_BASE_URL=https://file.shnea.kr
FILE_SERVICE_BEARER_TOKEN=
# 1..10485760 bytes; Nginx permits multipart overhead up to 11 MiB.
UPLOAD_MAX_BYTES=10485760
